      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && ((auth.uid == $uid && root.child('dev3dVendedores').child(auth.uid).child('activo').val() == true) || auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
        "$productoId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['precio']) && newData.child('precio').isNumber() && newData.child('precio').val() >= 0)"
        }
      }
    },
    "dev3dVentas": {
