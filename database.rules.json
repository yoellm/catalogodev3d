{
  "rules": {
    ".read": false,
    ".write": false,
    "productos": {
      ".read": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com' || auth.token.email == 'djsubixj@gmail.com' || auth.token.email == 'xiomaralamasmala@gmail.com')",
      "$productoId": {
        ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com' || auth.token.email == 'djsubixj@gmail.com' || auth.token.email == 'xiomaralamasmala@gmail.com')",
        ".validate": "(auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com') || (data.exists() && newData.exists() && newData.child('nombre').val() == data.child('nombre').val() && newData.child('yoel').val() == data.child('yoel').val() && newData.child('proximo').val() == data.child('proximo').val() && newData.child('ocultoIndex').val() == data.child('ocultoIndex').val())"
      }
    },
    "productos_publicos": {
      ".read": true,
      "$productoId": {
        ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com' || auth.token.email == 'djsubixj@gmail.com' || auth.token.email == 'xiomaralamasmala@gmail.com')",
        ".validate": "!newData.exists() || (newData.hasChildren(['nombre','laura','stock']) && newData.child('nombre').isString() && newData.child('laura').isNumber() && newData.child('stock').isNumber())"
      }
    },
    "logs": {
      ".read": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      "$logId": {
        ".write": "auth != null && !data.exists() && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com' || auth.token.email == 'djsubixj@gmail.com' || auth.token.email == 'xiomaralamasmala@gmail.com')"
      }
    },
    "liquidaciones": {
      ".read": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')"
    },
    "gastos": {
      ".read": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')"
    },
    "backup": {
      ".read": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')"
    },
    "dev3dCatalogoPublico": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      "$id": {
        ".validate": "newData.hasChildren(['nombre','precio'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
        },
        "precio": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "descripcion": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "categoria": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "imagen": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        },
        "wallapop": {
          ".validate": "newData.isString() && newData.val().length <= 2000 && (newData.val() == '' || newData.val().matches(/^https:\\/\\/([a-zA-Z0-9-]+\\.)*wallapop\\.com(\\/[^ ]*)?$/))"
        },
        "imagenes": {
          ".validate": "newData.hasChildren()",
          "$index": {
            ".validate": "$index.matches(/^[0-5]$/) && newData.isString() && newData.val().length <= 2000"
          }
        },
        "colores": {
          ".validate": "newData.hasChildren()",
          "$index": {
            ".validate": "$index.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          }
        },
        "estado": {
          ".validate": "newData.val() == 'disponible' || newData.val() == 'bajo_pedido' || newData.val() == 'agotado'"
        },
        "plazo": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "personalizable": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "dev3dCatalogoMayorista": {
      ".read": "(auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')) || (auth != null && root.child('dev3dTiendas').child(auth.uid).child('rol').val() == 'tienda' && root.child('dev3dTiendas').child(auth.uid).child('activo').val() == true)",
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      "$id": {
        ".validate": "newData.hasChildren(['precio','minimo'])",
        "precio": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "minimo": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "dev3dTiendas": {
      ".read": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['rol','activo','nombre'])",
        "rol": {
          ".validate": "newData.val() == 'tienda'"
        },
        "activo": {
          ".validate": "newData.isBoolean()"
        },
        "nombre": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254",
          ".write": "auth != null && auth.uid == $uid && root.child('dev3dTiendas').child($uid).child('rol').val() == 'tienda' && newData.isString() && newData.val() == auth.token.email"
        }
      }
    }
  }
}
