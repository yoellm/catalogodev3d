      ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com')",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['rol','activo','nombre'])",
        "rol": {
          ".validate": "newData.val() == 'tienda'"
        },
        "activo": {
          ".validate": "newData.isBoolean()"
        },
        "nombre": {
          ".validate": "newData.isString()"
        },
