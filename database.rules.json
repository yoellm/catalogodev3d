        ".write": "auth != null && (auth.token.email == 'yoelmejias@outlook.es' || auth.token.email == 'irelandmorcillo@gmail.com' || (auth.uid == $uid && root.child('dev3dVendedores').child(auth.uid).child('activo').val() == true))",
        "$ventaId": {
          ".validate": "!newData.exists() || (newData.child('vendedorUid').val() == $uid && newData.child('productoId').isString() && newData.child('cantidad').isNumber() && newData.child('cantidad').val() > 0 && newData.child('precioBase').isNumber() && newData.child('precioVenta').isNumber() && newData.child('totalCobrado').isNumber() && newData.child('gananciaVendedor').isNumber())"
        }
